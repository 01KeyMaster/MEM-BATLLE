{
  "name": "meme-battle",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "db:up": "docker compose --env-file .env -f docker/docker-compose.dev.yml up -d",
    "db:down": "docker compose --env-file .env -f docker/docker-compose.dev.yml down",
    "db:generate": "pnpm --filter @meme/db generate",
    "db:migrate": "pnpm --filter @meme/db migrate",
    "db:seed": "pnpm --filter @meme/db seed",
    "db:studio": "pnpm --filter @meme/db studio",
    "content:import": "pnpm --filter @meme/db content:import",
    "dev": "pnpm --parallel --filter @meme/api --filter @meme/web --filter @meme/bot dev",
    "dev:api": "pnpm --filter @meme/api dev",
    "dev:web": "pnpm --filter @meme/web dev",
    "dev:bot": "pnpm --filter @meme/bot dev",
    "dev:tg": "pnpm --filter @meme/bot tunnel",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck"
  },
  "devDependencies": {
    "typescript": "~5.9.3"
  }
}
