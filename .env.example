# Скопируй этот файл в .env и заполни значения. .env в git НЕ попадает.

# --- База данных (совпадает с docker/docker-compose.dev.yml) ---
POSTGRES_USER=meme
POSTGRES_PASSWORD=meme_dev_password
POSTGRES_DB=meme_battle
POSTGRES_PORT=5432
DATABASE_URL=postgresql://meme:meme_dev_password@localhost:5432/meme_battle

# --- Telegram ---
# Токен от @BotFather. Никому не показывай и не коммить.
BOT_TOKEN=
BOT_USERNAME=mem_fight_bot
# Короткое имя Mini App из /newapp (ссылка будет t.me/mem_fight_bot/<имя>)
MINI_APP_SHORT_NAME=
# https-адрес фронтенда (туннель cloudflared или домен) — для кнопки меню бота
WEB_APP_URL=
# Твой числовой Telegram ID (узнать можно у @userinfobot) — доступ к админке
ADMIN_TELEGRAM_ID=

# --- API ---
API_PORT=3000
# Адрес, по которому открывается фронтенд (для CORS и ссылок)
WEB_ORIGIN=http://localhost:5173
# Папка для картинок карт (относительно корня репозитория)
UPLOADS_DIR=uploads

# --- Локальная разработка ---
# Вход без Telegram (в Safari). На сервере ВСЕГДА false.
DEV_AUTH=true
# Под каким Telegram ID входить в Safari (можно свой — тогда будешь админом)
VITE_DEV_TELEGRAM_ID=111111

# --- Игра ---
WIN_SCORE=7

# Папка с твоими паками для pnpm content:import
CONTENT_DIR=content
